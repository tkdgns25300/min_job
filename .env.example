# Supabase 연결 — 값은 Supabase 대시보드 > Project Settings > API 에서 복사.
# 실제 값은 .env(gitignored)에 넣고, 배포는 Vercel 환경변수에 동일하게 입력.
# ⚠️ 데이터는 아직 mock(JSON) — 이 키들은 "연결만" 준비. 실제 사용(Auth·DB 조회)은 Phase 1.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# 공개 키 (RLS 적용) — 대시보드의 publishable(구 anon) 키. 클라이언트 노출 OK.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키 (RLS 우회) — 대시보드의 secret(구 service_role) 키. 서버 전용, 절대 노출 금지.
SUPABASE_SECRET_KEY=
